<% content_for :title, "#{@job.title} | Flying Crews" %>

<p><%= link_to "&laquo; Back to jobs".html_safe, jobs_path %></p>

<div class="card">
  <h1><%= @job.title %></h1>
  <p class="job-meta">
    <%= @job.company.name %> &middot; <%= @job.location %> &middot;
    <span class="badge"><%= @job.job_type.titleize %></span>
    <span class="badge"><%= @job.status.titleize %></span>
    <% if @job.category.present? %><span class="badge"><%= Job::CATEGORY_LABELS[@job.category] %></span><% end %>
  </p>
  <% if @job.formatted_salary_range %>
    <p><strong>Salary:</strong> <%= @job.formatted_salary_range %></p>
  <% end %>
  <p><%= simple_format(@job.description) %></p>

  <% if @job.company.description.present? %>
    <h2>About <%= @job.company.name %></h2>
    <p><%= simple_format(@job.company.description) %></p>
  <% end %>

  <% if logged_in? && (current_user.admin? || (current_user.recruiter? && current_user.recruiter.id == @job.recruiter_id)) %>
    <div class="actions">
      <%= link_to "Edit", edit_job_path(@job), class: "btn btn-secondary" %>
      <%= button_to "Delete", job_path(@job), method: :delete, class: "btn btn-danger",
            data: { turbo_confirm: "Delete this job posting?" } %>
    </div>
  <% elsif @existing_application %>
    <%# Always show the candidate's own status, even if the job has since
        closed (e.g. someone else was hired) — this isn't a new-applicant CTA. %>
    <p class="applied-status">
      &#10003; You applied &middot; Status: <span class="badge"><%= @existing_application.status.titleize %></span>
    </p>
  <% elsif !@job.published? %>
    <p class="job-meta">This job is no longer accepting applications.</p>
  <% elsif logged_in? && current_user.candidate? %>
    <%= link_to "Apply now", new_job_application_path(@job), class: "btn" %>
  <% elsif !logged_in? %>
    <p><%= link_to "Log in", login_path, class: "btn btn-secondary btn-sm" %> as a candidate to apply.</p>
  <% end %>
</div>
