<% content_for :title, "Jobs | Flying Crews" %>

<h1>Aviation Jobs</h1>

<%= form_with url: jobs_path, method: :get, class: "search",
      data: { controller: "live-search", turbo_frame: "jobs_results" } do %>
  <%= text_field_tag :q, params[:q], placeholder: "Title (e.g. Pilot, Cabin Crew)",
        data: { action: "keyup->live-search#search" } %>
  <%= text_field_tag :location, params[:location], placeholder: "Location",
        data: { action: "keyup->live-search#search" } %>
  <%= select_tag :category, options_for_select(Job::CATEGORY_LABELS.map { |key, label| [label, key] }, params[:category]), include_blank: "Any category" %>
  <%= select_tag :job_type, options_for_select(Job.job_types.keys.map { |t| [t.titleize, t] }, params[:job_type]), include_blank: "Any type" %>
  <%= number_field_tag :min_salary, params[:min_salary], placeholder: "Min salary" %>
  <%= submit_tag "Search", class: "btn" %>
  <%# _top, not jobs_results: Clear must reset the search FORM (q, location,
      category, job_type, min_salary), which lives outside the results
      frame. A frame-scoped navigation only swaps the job cards — the input
      boxes and selects still showed whatever was typed before Clear was
      clicked, because nothing ever told them to reset. %>
  <%= link_to "Clear", jobs_path, class: "btn btn-secondary", data: { turbo_frame: "_top" } %>
<% end %>

<% if logged_in? && current_user.recruiter? %>
  <p><%= link_to "+ Post a new job", new_job_path, class: "btn" %></p>
<% end %>

<%= turbo_frame_tag "jobs_results" do %>
  <% if @jobs.empty? %>
    <p>No jobs found matching your search.</p>
  <% end %>

  <%= render partial: "job_card", collection: @jobs, as: :job,
        locals: { applied_job_statuses: @applied_job_statuses } %>

  <%== pagy_bootstrap_nav(@pagy) if @pagy.pages > 1 %>
<% end %>
