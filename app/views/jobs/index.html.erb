<% content_for :title, "Jobs | Flying Crews" %>

<h1>Aviation Jobs</h1>

<%= form_with url: jobs_path, method: :get, class: "search", local: true do %>
  <%= text_field_tag :q, params[:q], placeholder: "Title (e.g. Pilot, Cabin Crew)" %>
  <%= text_field_tag :location, params[:location], placeholder: "Location" %>
  <%= select_tag :category, options_for_select(Job::CATEGORY_LABELS.map { |key, label| [label, key] }, params[:category]), include_blank: "Any category" %>
  <%= select_tag :job_type, options_for_select(Job.job_types.keys.map { |t| [t.titleize, t] }, params[:job_type]), include_blank: "Any type" %>
  <%= number_field_tag :min_salary, params[:min_salary], placeholder: "Min salary" %>
  <%= submit_tag "Search" %>
  <%= link_to "Clear", jobs_path %>
<% end %>

<% if logged_in? && current_user.recruiter? %>
  <p><%= link_to "+ Post a new job", new_job_path %></p>
<% end %>

<% if @jobs.empty? %>
  <p>No jobs found matching your search.</p>
<% end %>

<%= render partial: "job_card", collection: @jobs, as: :job %>
