<% content_for :title, "Dashboard | Flying Crews" %>
<h1>Dashboard</h1>

<% case current_user.role %>
<% when "candidate" %>
  <p><%= link_to "Edit Profile", edit_candidate_profile_path, class: "btn btn-secondary btn-sm" %></p>
  <h2>Your applications</h2>
  <% if @applications.empty? %>
    <p>You haven't applied to any jobs yet.</p>
    <p><%= link_to "Browse jobs", jobs_path, class: "btn" %></p>
  <% else %>
    <table>
      <thead><tr><th>Job</th><th>Company</th><th>Status</th><th>Applied</th></tr></thead>
      <tbody>
        <% @applications.each do |app| %>
          <tr>
            <td><%= link_to app.job.title, app.job %></td>
            <td><%= app.job.company.name %></td>
            <td><span class="badge"><%= app.status.titleize %></span></td>
            <td><%= app.applied_at&.strftime("%b %d, %Y") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <%== pagy_bootstrap_nav(@pagy) if @pagy.pages > 1 %>
  <% end %>

<% when "recruiter" %>
  <p><%= link_to "+ Post a new job", new_job_path, class: "btn" %></p>
  <h2>Your job postings</h2>
  <% if @jobs.empty? %>
    <p>You haven't posted any jobs yet.</p>
  <% else %>
    <% @jobs.each do |job| %>
      <div class="card">
        <p class="job-title"><%= link_to job.title, job %></p>
        <p class="job-meta"><%= job.applications.size %> application(s) &middot; <span class="badge"><%= job.status.titleize %></span></p>
        <% if job.applications.any? %>
          <table>
            <thead><tr><th>Candidate</th><th>Status</th><th>Update</th></tr></thead>
            <tbody>
              <% job.applications.each do |app| %>
                <tr>
                  <td>
                    <strong><%= app.candidate.user.name %></strong>
                    <% if app.candidate.headline.present? %><br><span class="job-meta"><%= app.candidate.headline %></span><% end %>
                    <% if app.candidate.experience_years.present? %><br><span class="job-meta"><%= pluralize(app.candidate.experience_years, "year") %> experience</span><% end %>
                    <% if app.candidate.skills.present? %><br><span class="job-meta">Skills: <%= app.candidate.skills %></span><% end %>
                    <% if app.candidate.resume_url.present? %><br><%= link_to "View resume", app.candidate.resume_url, target: "_blank", rel: "noopener" %><% end %>
                  </td>
                  <td><span class="badge"><%= app.status.titleize %></span></td>
                  <td>
                    <%= form_with url: update_status_application_path(app), method: :patch, local: true do |f| %>
                      <%= select_tag :status, options_for_select(Application.statuses.keys.map { |s| [s.titleize, s] }, app.status), onchange: "this.form.requestSubmit()" %>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% end %>
      </div>
    <% end %>
    <%== pagy_bootstrap_nav(@pagy) if @pagy.pages > 1 %>
  <% end %>

<% when "admin" %>
  <%= render "admin/nav" %>
  <div class="card"><strong>Jobs posted:</strong> <%= link_to @jobs_count, admin_jobs_path %></div>
  <div class="card"><strong>Applications submitted:</strong> <%= link_to @applications_count, admin_applications_path %></div>
  <div class="card"><strong>Companies:</strong> <%= link_to @companies_count, admin_companies_path %></div>
  <div class="card"><strong>Candidates:</strong> <%= link_to @candidates_count, admin_users_path %></div>
<% end %>
