<% content_for :title, "Log in | Flying Crews" %>
<h1>Log in</h1>

<%= form_with url: login_path, method: :post, local: true do %>
  <div class="field">
    <%= label_tag :email %>
    <%= email_field_tag :email %>
  </div>
  <div class="field">
    <%= label_tag :password %>
    <%= password_field_tag :password %>
  </div>
  <%= submit_tag "Log in" %>
<% end %>

<p>No account? <%= link_to "Sign up", signup_path %></p>
